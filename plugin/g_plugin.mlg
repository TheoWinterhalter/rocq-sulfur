DECLARE PLUGIN "rocq-sulfur.plugin"

{
  open Signature
  open Stdarg
  open Procq.Prim
  open Procq.Constr
}

(** Sort declaration *)
VERNAC ARGUMENT EXTEND sort_decl
| [ identref(sort) "(" identref(v) ")" ":" "Type" ] ->
  { { sort ; var_ctor = Some v } }
| [ identref(sort) ":" "Type" ] -> { { sort ; var_ctor = None } }
| [ identref(sort) "(" identref(v) ")" ] -> { { sort ; var_ctor = Some v } }
| [ identref(sort) ] -> { { sort ; var_ctor = None } }
END

(** A constructor declaration, [| app : term -> term -> term]. *)
VERNAC ARGUMENT EXTEND decl
| [ "|" identref(name) ":" lconstr(ty) ] -> { CAst.make ~loc { name ; ty } }
END

(** A signature, first a sort and then a list of declarations. *)
VERNAC ARGUMENT EXTEND signature
| [ sort_decl(sort) ":=" decl_list(ctors) ] -> { { sort ; ctors } }
END

VERNAC COMMAND EXTEND SulfurSyntax CLASSIFIED AS SIDEFF
| [ "Sulfur" "Syntax" signature(s) ] -> { Main.generate s }
END


(* Judgment generation *)

(** A premise: a judgment, or [{{ P }}] with [P] a proposition over the
  context [Γ] and the meta-variables as concrete terms. *)
VERNAC ARGUMENT EXTEND jdg_prem
| [ "{{" lconstr(e) "}}" ] -> { Jdg.PPred e }
| [ lconstr(e) ] -> { Jdg.PJdg e }
END

(** An inference rule itself. *)
VERNAC ARGUMENT EXTEND jdg_line
| [ "─" jdg_line ] -> { () }
| [ "─" ] -> { () }
END

(** [⟹], or a line. *)
VERNAC ARGUMENT EXTEND jdg_bar
| [ "⟹" ] -> { () }
| [ jdg_line ] -> { () }
END

(** [| name (A B : term) : R t A ; R u B ⟹ R (c t u) C]. *)
VERNAC ARGUMENT EXTEND jdg_rule
| [ "|" ident(n) binders(bs) ":" jdg_prem_list_sep(ps, ";") jdg_bar lconstr(c) ] ->
  { Jdg.{ pr_name = n ; pr_binders = bs ; pr_prems = ps ; pr_concl = c } }
END

VERNAC ARGUMENT EXTEND jdg_header
| [ ident(name) ":" lconstr(ty) "with" ident(g) ":" constr(d) ","
      "Variable" ident(x) ident_list(ds) ":" ident(r) ident_list(args) ] ->
  { Jdg.{ ph_name = name ; ph_type = ty ; ph_ctx = g ; ph_decl = d ;
          ph_var = x ; ph_decls = ds ; ph_jdg = r ; ph_args = args } }
END

(** A judgment and its rules, [header := rules]. *)
VERNAC ARGUMENT EXTEND jdg_block
| [ jdg_header(h) ":=" jdg_rule_list(rs) ] -> { (h, rs) }
END

(** Several judgments, separated by [with]. *)
VERNAC COMMAND EXTEND SulfurJudgment CLASSIFIED AS SIDEFF
| [ "Sulfur" "Judgment" ne_jdg_block_list_sep(bs, "with") ] ->
  { Jdg.generate_rules bs }
END
