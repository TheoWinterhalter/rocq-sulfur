# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "A Rocq plugin to automate reasoning about languages with binders"
description: """
Sulfur generates, from a signature, the syntax of a language with binders
together with renaming, substitution, and a tactic (ssimpl) that normalises
terms and substitutions."""
maintainer: ["Théo Winterhalter (theo.winterhalter@inria.fr)"]
authors: ["Mathis Bouverot-Dupuis (mathis.bouverot@ens.psl.eu)"]
tags: [
  "keyword:binders"
  "keyword:substitution"
  "category:Miscellaneous/Rocq Extensions"
  "logpath:Sulfur"
  "date:2026-10-19"
]
homepage: "https://github.com/TheoWinterhalter/rocq-sulfur"
bug-reports: "https://github.com/TheoWinterhalter/rocq-sulfur/issues"
depends: [
  "dune" {>= "3.21"}
  "rocq-prover" {>= "9.3.0" & < "9.4~"}
  "rocq-equations"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheoWinterhalter/rocq-sulfur.git"
x-maintenance-intent: ["(latest)"]
